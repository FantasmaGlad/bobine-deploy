{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Deploy",
  "version": "0.0.1",
  "identifier": "fit.bobine.deploy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bobine Deploy",
        "width": 1080,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#f8f9fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FantasmaGlad",
    "copyright": "AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Installer et maintenir Bobine sur les machines du réseau",
    "longDescription": "Trouve les machines du réseau local, s'y connecte en SSH, vérifie le matériel et installe Bobine avec une progression en temps réel. Même fonctions en ligne de commande.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"
        ],
        "section": "utils",
        "conflicts": [
          "bobine-assistant"
        ],
        "replaces": [
          "bobine-assistant"
        ]
      },
      "rpm": {
        "conflicts": [
          "bobine-assistant"
        ],
        "obsoletes": [
          "bobine-assistant"
        ]
      }
    },
    "homepage": "https://bobine.fit",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
